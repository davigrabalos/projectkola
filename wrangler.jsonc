// Cloudflare Worker: serves the built site (dist/), the /api routes and the jobs cron.
// Deploy: `npm run deploy` (also what Cloudflare Workers Builds should run). The first deploy creates the
// "kola" D1 database automatically (no database_id needed: wrangler finds it by name), then applies migrations.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectkola",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served as a static file without running the Worker.
    // ("/__scheduled" only lets `wrangler dev --test-scheduled` reach the cron handler locally.)
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kola",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Job ingest cron, paused while the site runs on mock data (src/data, `npm run mock:refresh`).
  // An empty list (not a missing key) removes the deployed schedule. To switch back to real jobs, set
  // ["*/15 * * * *"] (a few sources every 15 minutes; needs Workers Paid, see worker/ingest/run.ts) and build with `npm run build:api`.
  "triggers": { "crons": [] },
  "vars": { "INGEST_PER_RUN": "3", "CACHE_TTL": "60" },
  "observability": { "enabled": true }
}
